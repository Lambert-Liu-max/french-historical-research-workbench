      "output_usd_per_million_tokens": 0.28
    },
    "qwen": {
      "provider": "aihubmix",
      "model": "qwen3-vl-plus",
      "input_usd_per_million_tokens": 0.137,
      "output_usd_per_million_tokens": 1.37
    },
    "gpt": {
      "provider": "aihubmix",
      "model": "gpt-5.6-terra",
      "input_usd_per_million_tokens": 2.5,
      "output_usd_per_million_tokens": 15.0
    }
  }
}
